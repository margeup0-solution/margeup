# .gitignore for MargeUp project
# Node dependencies
node_modules/

# Environment variables
.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/

# IDE/editor files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Test coverage
coverage/

# Misc temporary files
*.tmp
